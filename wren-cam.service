[Unit]
Description=wren-cam — Raspberry Pi 5 bird cam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/wren-cam
Environment=WREN_CAM_CONFIG=/home/pi/wren-cam/config.json
ExecStart=/home/pi/wren-cam/.venv/bin/python -m wren_cam
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
